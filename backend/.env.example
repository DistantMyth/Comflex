[TEMPLATE]
# ============================================================
# Comflex Backend — Environment Variables
# Copy to backend/.env for local development
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas). Example local: mongodb://localhost:27017/comflex
DATABASE_URL=mongodb://localhost:27017/comflex

# JWT secrets — generate strong ones in production
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Seed Admin (created on first boot)
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=change-me-1234
SEED_ADMIN_DISPLAY_NAME=Platform Admin

# CORS — frontend origin (Vite dev server by default)
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=

# Email: "console" (log only) | "smtp"
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@comflex.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (OPTIONAL locally, REQUIRED on Render/Vercel)
# Uploads go to Cloudinary when set — they survive Render's /tmp wipes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini — powers the AI Notes Assistant chatbot.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — EVM wallet that receives crypto credit purchases (Web3 store).
TREASURY_ADDRESS=
